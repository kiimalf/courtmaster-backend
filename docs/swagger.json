    "definitions": {
        "model.AddReplyRequest": {
            "type": "object",
            "required": [
                "comment"
            ],
            "properties": {
                "comment": {
                    "type": "string",
                    "maxLength": 300,
                    "minLength": 2
                }
            }
        },
        "model.CreateBookingRequest": {
            "type": "object",
            "required": [
                "court_id",
                "date",
                "slot_ids"
            ],
            "properties": {
                "court_id": {
                    "type": "integer"
                },
                "date": {
                    "type": "string"
                },
                "slot_ids": {
                    "type": "array",
                    "maxItems": 4,
                    "minItems": 1,
                    "items": {
                        "type": "integer"
                    }
                }
            }
        },
        "model.CreateCourtRequest": {
            "type": "object",
            "required": [
                "hourly_rate",
                "name",
                "sport_type"
            ],
            "properties": {
                "hourly_rate": {
                    "type": "number"
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 3
                },
                "sport_type": {
                    "type": "string",
                    "enum": [
                        "padel",
                        "badminton",
                        "futsal",
                        "basketball"
                    ]
                }
            }
        },
        "model.CreateReviewRequest": {
            "type": "object",
            "required": [
                "comment",
                "rating"
            ],
            "properties": {
                "comment": {
                    "type": "string",
                    "maxLength": 500,
                    "minLength": 5
                },
                "rating": {
                    "type": "integer",
                    "maximum": 5,
                    "minimum": 1
                },
                "tags": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "model.CreateSparringRequest": {
            "type": "object",
            "required": [
                "court_id",
                "date",
                "end_time",
                "max_participants",
                "price_per_person",
                "start_time",
                "title"
            ],
            "properties": {
                "court_id": {
                    "type": "integer"
                },
                "date": {
                    "type": "string"
                },
                "end_time": {
                    "type": "string"
                },
                "max_participants": {
                    "type": "integer",
                    "maximum": 20,
                    "minimum": 2
                },
                "price_per_person": {
                    "type": "number",
                    "minimum": 0
                },
                "start_time": {
                    "type": "string"
                },
                "title": {
                    "type": "string",
                    "maxLength": 150,
                    "minLength": 5
                }
            }
        },
        "model.LoginRequest": {
            "type": "object",
            "required": [
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "identifier": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "model.RefreshRequest": {
            "type": "object",
            "required": [
                "refresh_token"
            ],
            "properties": {
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "model.RegisterRequest": {
            "type": "object",
            "required": [
                "email",
                "name",
                "password",
                "role_id",
                "username"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 2
                },
                "password": {
                    "type": "string",
                    "minLength": 8
                },
                "role_id": {
                    "type": "integer",
                    "enum": [
                        2,
                        3
                    ]
                },
                "username": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 3
                }
            }
        },
        "model.SwapBookingRequest": {
            "type": "object",
            "required": [
                "booking_id",
                "court_id",
                "date",
                "new_slot_id",
                "old_slot_id"
            ],
            "properties": {
                "booking_id": {
                    "type": "integer"
                },
                "court_id": {
                    "type": "integer"
                },
                "date": {
                    "type": "string"
                },
                "new_slot_id": {
                    "type": "integer"
                },
                "old_slot_id": {
                    "type": "integer"
                }
            }
        },
        "model.UpdateHourlyRateRequest": {
            "type": "object",
            "required": [
                "hourly_rate",
                "version"
            ],
            "properties": {
                "hourly_rate": {
                    "type": "number"
                },
                "version": {
                    "type": "integer"
                }
            }
        },
        "model.WebResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "errors": {},
                "message": {
                    "type": "string"
                },
                "meta": {},
                "success": {
                    "type": "boolean"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}